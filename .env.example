# Base de la API. Por defecto '/api' (CloudFront enruta /api/* a API Gateway; sin CORS).
# Puede ser absoluta, p. ej. https://xxxx.execute-api.us-east-1.amazonaws.com (requiere CORS en el backend).
VITE_API_BASE_URL=/api

# Solo desarrollo: destino del proxy de Vite para /api (se quita el prefijo /api).
DEV_API_TARGET=http://localhost:8080
